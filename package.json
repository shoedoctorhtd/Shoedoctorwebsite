{
  "name": "shoe-doctor-hetauda",
  "version": "0.1.0",
  "private": true,
  "description": "This repository contains the complete Shoe Doctor website, booking system and owner dashboard. It runs as one Cloudflare Worker:",
  "homepage": "https://github.com/shoedoctorhtd/Shoedoctorwebsite#readme",
  "bugs": {
    "url": "https://github.com/shoedoctorhtd/Shoedoctorwebsite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://shoedoctorhtd@github.com/shoedoctorhtd/Shoedoctorwebsite.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "directories": {
    "example": "examples",
    "lib": "lib",
    "test": "tests"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply shoe-doctor-db --remote",
    "auth:secret": "node scripts/generate-session-secret.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "displayName": "Shoe Doctor"
}
